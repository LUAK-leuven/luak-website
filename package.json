{
  "name": "luak-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv .env.local",
    "dev:prod": "nuxt dev --dotenv .env.production",
    "generate": "nuxt generate",
    "preview": "NODE_OPTIONS='--import ./public/instrument.server.mjs' nuxt preview --dotenv .env.local",
    "sb:start": "supabase start -x edge-runtime,imgproxy,logflare,realtime,storage-api,supavisor,vector",
    "sb:gentypes": "yarn --silent supabase gen types --lang typescript --local > types/database.types.ts",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "yarn lint:eslint && yarn lint:prettier",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "lintfix": "yarn eslint . --fix && yarn prettier --write --list-different .",
    "test": "yarn test:unit && yarn test:e2e",
    "test:e2e": "playwright test",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxtjs/supabase": "^2.0.10",
    "@nuxtjs/tailwindcss": "^6.8.0",
    "@playwright/test": "^1.62.0",
    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.4.6",
    "daisyui": "^3.9.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-nuxt": "^4.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "happy-dom": "^20.11.2",
    "nuxt": "^4.5.1",
    "nuxt-studio": "^1.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "sass": "^1.99.0",
    "supabase": "^2.115.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.10"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@nuxt/content": "^3.15.2",
    "@nuxt/image": "^2.1.0",
    "@vee-validate/nuxt": "^4.12.8",
    "@vee-validate/yup": "^4.12.8",
    "@vueuse/core": "^14.4.0",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.23",
    "nuxt-typed-router": "^4.0.10",
    "qrcode": "^1.5.4",
    "yup": "^1.7.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": "^22.0.0"
  }
}
