{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "orchestrator",
  "permission": {
    "external_directory": "deny",
    "read": {
      ".opencode/**": "ask"
    },
    "edit": {
      ".opencode/**": "ask"
    },
    "glob": {
      ".opencode/**": "ask"
    },
    "grep": {
      ".opencode/**": "ask"
    },
    "bash": {
      "*": "ask"
    }
  },
  "agent": {
    "explore": {
      "model": "github-copilot/claude-haiku-5.5"
    }
  },
  "lsp": true
}
