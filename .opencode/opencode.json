{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nuxt": {
      "type": "remote",
      "url": "https://nuxt.com/mcp"
    }
  },
  "permission": {
    "read": {
      "*node_modules*": "deny",
      "*": "allow"
    },
    "edit": {
      "*node_modules*": "deny",
      "*": "ask"
    },
    "glob": {
      "*node_modules*": "deny",
      "*": "allow"
    },
    "grep": {
      "*node_modules*": "deny",
      "*": "allow"
    },
    "list": {
      "*node_modules*": "deny",
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "git": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "yarn": "ask",
      "yarn test*": "allow",
      "yarn dev*": "allow",
      "yarn lintfix": "allow",
      "yarn lint*": "allow",
      "yarn eslint*": "allow",
      "yarn prettier*": "allow",
      "yarn build*": "allow",
      "yarn typecheck*": "allow",
      "yarn vitest *": "allow",
      "npx *": "deny",
      "cd *": "deny",
      "ls *": "deny",
      "sleep *": "allow",
      "cat *": "deny",
      "head *": "allow",
      "tail *": "allow",
      "rg *": "allow",
      "echo *": "allow",
      "sed *": "allow",
      "grep *": "deny",
      "wc *": "allow",
      "sort *": "allow",
      "xargs *": "allow"
    },
    "lsp": "allow"
  },
  "agent": {
    "plan": {
      "permission": {
        "skill": {
          "implement": "deny",
          "playwright-cli": "deny",
          "upgrade-package": "deny"
        },
        "read": {
          "*node_modules*": "deny",
          "*": "allow"
        },
        "glob": {
          "*node_modules*": "deny",
          "*": "allow"
        },
        "grep": {
          "*node_modules*": "deny",
          "*": "allow"
        },
        "list": {
          "*node_modules*": "deny",
          "*": "allow"
        },
        "edit": "ask",
        "write": "ask",
        "bash": {
          "*": "ask",
          "ls *": "deny",
          "cat *": "deny",
          "head *": "allow",
          "tail *": "allow",
          "rg *": "allow",
          "echo *": "allow",
          "sed *": "allow",
          "grep *": "deny",
          "wc *": "allow",
          "find *": "allow",
          "xargs *": "allow",
          "sort *": "allow"
        }
      }
    }
  }
}
