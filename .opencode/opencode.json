{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*node_modules/*", "effect": "deny" },
    { "action": "read", "resource": ".opencode/*", "effect": "deny" },
    { "action": "read", "resource": "AGENTS.md", "effect": "deny" },

    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*.env*", "effect": "deny" },
    { "action": "glob", "resource": "*.env.example", "effect": "allow" },
    { "action": "glob", "resource": "*node_modules/*", "effect": "deny" },
    { "action": "glob", "resource": ".opencode/*", "effect": "deny" },

    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*.env*", "effect": "deny" },
    { "action": "grep", "resource": "*.env.example", "effect": "allow" },
    { "action": "grep", "resource": "*node_modules/*", "effect": "deny" },
    { "action": "grep", "resource": ".opencode/*", "effect": "deny" },
    { "action": "grep", "resource": "AGENTS.md", "effect": "deny" },

    {
      "action": "webfetch",
      "resource": "https://nuxt.com/docs/4.x/*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "https://refactoring.guru/*",
      "effect": "allow"
    },

    { "action": "shell", "resource": "cat *", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "explore": {
      "model": "github-copilot/claude-haiku-5.5"
    }
  },
  "formatter": {
    "eslint": {
      "command": ["yarn", "eslint", "--fix", "$FILE"],
      "extensions": [".ts", ".js", ".mjs", ".vue"]
    },
    "prettier": {
      "command": ["yarn", "prettier", "--write", "$FILE"],
      "extensions": [".ts", ".js", ".mjs", ".vue", ".json", ".css"]
    }
  }
}
